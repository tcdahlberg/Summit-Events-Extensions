<!--
US-08: decline a Summit Events invitation without completing registration. See InvitationDeclineController.
-->
<apex:page id="InvitationDecline" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" docType="html-5.0" cache="false" controller="InvitationDeclineController">
    <apex:composition template="{!templateSelected}">
        <apex:define name="metaPageTitle">
            {!eventPage.summit__Event_Name__c}
            <apex:outputText rendered="{!!ISBLANK(eventRegistration.summit__Event_Instance_Title__c)}" value="{! ' - ' + eventRegistration.summit__Event_Instance_Title__c}"/>
            - Decline
        </apex:define>
        <apex:define name="pageTitle"><a href="{!eventPage.summit__Event_Home_Link_URL__c}">{!eventPage.summit__Event_Home_Link_Title__c}</a></apex:define>
        <apex:define name="scriptsHead">
            <link href="{!URLFOR($Resource.summit__SummitEventsAssets, '/css/main.css')}" rel="stylesheet" type="text/css"/>
            <script>
                window.dataLayer = window.dataLayer || [];
                dataLayer.push({
                    'audience': '{!JSENCODE(IF(!ISBLANK(eventPage.summit__Audience__c), eventPage.summit__Audience__c, ''))}',
                    'event': 'summit_decline',
                    'eventLabel': '{!JSENCODE(eventPage.summit__Event_Name__c)}{!JSENCODE(IF(!ISBLANK(eventRegistration.summit__Event_Instance_Title__c), ' - ' + eventRegistration.summit__Event_Instance_Title__c, ''))}',
                    'page': '{!JSENCODE($CurrentPage.Name)}'
                });
            </script>
        </apex:define>
        <apex:define name="sectionNav"/>

        <apex:define name="body">
            <div class="slds-grid slds-wrap" xmlns="http://www.w3.org/2000/svg" version="1.1">

                <apex:messages layout="list" styleClass="slds-col slds-p-around_x-small slds-size_1-of-1 slds-notify slds-notify_toast slds-theme_warning"/>

                <apex:form id="InvitationDeclineForm" styleClass="slds-grid slds-wrap" style="width:100%">

                    <!-- EVENT BREADCRUMB -->
                    <apex:outputPanel layout="block" styleClass="slds-col slds-p-vertical_x-small slds-size_1-of-1" rendered="{!!eventNotFound}">
                        <nav role="navigation" aria-label="Breadcrumbs">
                            <ol class="slds-breadcrumb slds-list_horizontal">
                                <apex:outputPanel rendered="{!!ISBLANK(eventPage.summit__Event_Name__c)}" layout="none">
                                    <li class="slds-breadcrumb__item slds-text-title_caps slds-p-right_x-small">{!eventPage.summit__Event_Name__c}</li>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!!ISBLANK(eventRegistration.summit__Event_Instance_Title__c)}" layout="none">
                                    <li class="slds-breadcrumb__item slds-text-title_caps slds-p-horizontal_x-small">{!eventRegistration.summit__Event_Instance_Title__c}</li>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!!ISBLANK(eventRegistration.summit__Event_Instance_Date_Time_Formatted__c)}" layout="none">
                                    <li class="slds-breadcrumb__item slds-text-title_caps slds-p-horizontal_x-small">{!eventRegistration.summit__Event_Instance_Date_Time_Formatted__c}</li>
                                </apex:outputPanel>
                            </ol>
                        </nav>
                    </apex:outputPanel>

                    <!-- NOT FOUND: same wording as the package cancel page so a bad link reveals nothing -->
                    <apex:outputPanel layout="block" styleClass="slds-col slds-size_1-of-1 slds-p-vertical_x-small regularLists" rendered="{!eventNotFound}">
                        <h2 class="slds-text-heading_large slds-p-vertical_xx-small">No event found</h2>
                        <p class="slds-text-body slds-p-vertical_xx-small">The link you followed doesn't contain information to any registration we have on file.</p>
                    </apex:outputPanel>

                    <!-- ALREADY DECLINED -->
                    <apex:outputPanel layout="block" styleClass="slds-col slds-size_1-of-1 slds-p-vertical_x-small regularLists" rendered="{!!eventNotFound && alreadyDeclined}">
                        <h2 class="slds-text-heading_large slds-p-vertical_xx-small">You have declined this invitation</h2>
                        <p class="slds-text-body slds-p-vertical_xx-small">Thank you for letting us know that you will not attend.</p>
                    </apex:outputPanel>

                    <!-- REGISTERED OR OTHERWISE NOT DECLINABLE -->
                    <apex:outputPanel layout="block" styleClass="slds-col slds-size_1-of-1 slds-p-vertical_x-small regularLists" rendered="{!!eventNotFound && notDeclinable}">
                        <h2 class="slds-text-heading_large slds-p-vertical_xx-small">This invitation can no longer be declined</h2>
                        <p class="slds-text-body slds-p-vertical_xx-small">If your plans have changed, please use the cancel link in your registration confirmation or contact the event organizer.</p>
                    </apex:outputPanel>

                    <!-- DECLINE CONFIRMATION -->
                    <apex:outputPanel layout="none" rendered="{!!eventNotFound && canDecline}">
                        <div id="declineWrapper" class="slds-col slds-size_1-of-1 slds-p-vertical_x-small regularLists">
                            <h2 class="slds-text-heading_large">
                                <apex:outputText value="{!eventPage.summit__Event_Name__c}"/>
                            </h2>
                            <apex:outputPanel layout="none" rendered="{!!ISBLANK(eventRegistration.summit__Event_Instance_Title__c)}">
                                <h3 class="slds-text-heading_medium">
                                    {!eventRegistration.summit__Event_Instance_Title__c}
                                </h3>
                            </apex:outputPanel>
                            <p class="slds-text-body slds-p-vertical_xx-small regularLists">
                                <apex:outputText escape="false" value="{!eventPage.summit__Event_description__c}"/>
                            </p>
                            <p class="slds-text-body slds-p-vertical_small">
                                Unable to attend? Let us know below. You do not need to complete the registration form.
                            </p>

                            <!-- US-09: optional reason and comment; declining works with both left empty -->
                            <div class="slds-form-element slds-p-vertical_x-small">
                                <apex:outputLabel for="declineReason" value="Reason (optional)" styleClass="slds-form-element__label"/>
                                <div class="slds-form-element__control">
                                    <div class="slds-select_container">
                                        <apex:selectList id="declineReason" value="{!declineReason}" size="1" styleClass="slds-select">
                                            <apex:selectOptions value="{!declineReasonOptions}"/>
                                        </apex:selectList>
                                    </div>
                                </div>
                            </div>
                            <div class="slds-form-element slds-p-vertical_x-small">
                                <apex:outputLabel for="declineComment" value="Comment (optional)" styleClass="slds-form-element__label"/>
                                <div class="slds-form-element__control">
                                    <apex:inputTextarea id="declineComment" value="{!declineComment}" rows="4" styleClass="slds-textarea" html-maxlength="{!declineCommentLength}" html-aria-describedby="declineCommentHelp"/>
                                </div>
                                <div id="declineCommentHelp" class="slds-form-element__help">
                                    <span id="declineCommentCount">0</span> / {!declineCommentLength}
                                </div>
                            </div>
                            <script>
                                (function () {
                                    var comment = document.querySelector('textarea[id$=":declineComment"]');
                                    var count = document.getElementById('declineCommentCount');
                                    if (comment && count) {
                                        comment.addEventListener('input', function () {
                                            count.textContent = comment.value.length;
                                        });
                                    }
                                })();
                            </script>

                            <p class="slds-text-body slds-p-vertical_small">
                                <apex:commandButton action="{!declineInvitation}" value="Decline invitation" id="declineInvitation" styleClass="slds-button slds-button_brand slds-p-horizontal_xx-large slds-p-vertical_xx-small"/>
                            </p>
                        </div>
                    </apex:outputPanel>

                    <div class="slds-col slds-size_1-of-1 slds-clearfix slds-p-vertical_x-small regularLists">
                        <apex:outputText escape="false" value="{!eventPage.summit__Event_Footer__c}"/>
                    </div>
                </apex:form>
            </div>
        </apex:define>
    </apex:composition>
</apex:page>
